<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_car_workshop_tree" model="ir.ui.view">
            <field name="name">car.workshop.tree</field>
            <field name="model">car.workshop</field>
            <field name="arch" type="xml">
                <tree string="Órdenes de Taller" decoration-info="state == 'draft'" decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="license_plate"/>
                    <field name="workshop_district_id"/>
                    <field name="entry_date"/>
                    <field name="responsible_id"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('draft', 'in_progress')" decoration-warning="state == 'ready'" decoration-muted="state == 'cancelled'"/>
                </tree>
            </field>
        </record>

        <record id="view_car_workshop_form" model="ir.ui.view">
            <field name="name">car.workshop.form</field>
            <field name="model">car.workshop</field>
            <field name="arch" type="xml">
                <form string="Orden de Taller">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,ready,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="license_plate"/>
                                <field name="vehicle_description"/>
                                <field name="workshop_district_id"/>
                            </group>
                            <group>
                                <field name="entry_date"/>
                                <field name="departure_date"/>
                                <field name="responsible_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detalles y Notas">
                                <group>
                                    <field name="customer_notes" nolabel="1" placeholder="Notas del Cliente..."/>
                                    <field name="technician_notes" nolabel="1" placeholder="Notas del Técnico..."/>
                                </group>
                            </page>
                            <page string="Verificación de Servicios">
                                <field name="service_check_ids" mode="tree">
                                    <tree string="Verificación de Servicios" editable="bottom">
                                        <field name="service_id"/>
                                        <field name="completed"/>
                                    </tree>
                                    <form string="Detalle Servicio">
                                         <group>
                                            <field name="service_id"/>
                                            <field name="completed"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Imágenes">
                                <field name="image_ids" mode="kanban">
                                     <kanban>
                                        <field name="image"/>
                                        <field name="description"/>
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div class="oe_kanban_global_click">
                                                    <div class="o_kanban_image">
                                                        <field name="image" widget="image" class="o_image_128_max"/>
                                                    </div>
                                                    <div class="oe_kanban_details">
                                                        <field name="description"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                     </kanban>
                                     <form string="Detalle Imagen">
                                        <sheet>
                                            <field name="image" widget="image" class="oe_avatar"/>
                                            <group>
                                                <field name="description"/>
                                            </group>
                                        </sheet>
                                     </form>
                                      <tree string="Imágenes" editable="bottom">
                                        <field name="image" widget="image" options="{'size': [50, 50]}"/>
                                        <field name="description"/>
                                     </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                     <div class="oe_chatter">
                         <field name="message_follower_ids"/>
                         <field name="activity_ids"/>
                         <field name="message_ids"/>
                     </div>
                </form>
            </field>
        </record>

        <record id="view_car_workshop_search" model="ir.ui.view">
            <field name="name">car.workshop.search</field>
            <field name="model">car.workshop</field>
            <field name="arch" type="xml">
                <search string="Buscar Orden de Taller">
                    <field name="name" string="Referencia"/>
                    <field name="license_plate"/>
                    <field name="workshop_district_id"/>
                    <field name="responsible_id"/>
                    <filter string="Borrador" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="En Progreso" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Listo" name="filter_ready" domain="[('state', '=', 'ready')]"/>
                    <filter string="Hecho" name="filter_done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Distrito" name="group_by_district" context="{'group_by': 'workshop_district_id'}"/>
                        <filter string="Responsable" name="group_by_responsible" context="{'group_by': 'responsible_id'}"/>
                        <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Fecha Entrada" name="group_by_entry_date" context="{'group_by': 'entry_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_car_workshop" model="ir.actions.act_window">
            <field name="name">Órdenes de Taller</field>
            <field name="res_model">car.workshop</field>
            <field name="view_mode">tree,form</field> <field name="search_view_id" ref="view_car_workshop_search"/>
            <field name="context">{}</field> <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea una nueva orden de trabajo para el taller.
                </p><p>
                    Registra los detalles del vehículo, las notas del cliente, los servicios a realizar y las imágenes.
                </p>
            </field>
        </record>

    </data>
</odoo>