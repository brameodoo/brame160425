<record id="view_expense_form" model="ir.ui.view">
    <field name="name">hr.expense.form</field>
    <field name="model">hr.expense</field>
    <field name="inherit_id" ref="hr_expense.view_form"/> <!-- ojo: id correcto de la vista base -->
    <field name="arch" type="xml">
        <xpath expr="//button[@name='action_submit_expenses']" position="after">
            <button name="action_adjust_expense" type="object" string="Ajustar Gasto" class="oe_highlight"/>
        </xpath>
    </field>
</record>
