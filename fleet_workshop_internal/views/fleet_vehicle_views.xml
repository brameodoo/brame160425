<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_inherit_workshop" model="ir.ui.view">
        <name>fleet.vehicle.form.inherit.workshop</name>
        <model>fleet.vehicle</model>
        <inherit_id ref="fleet.fleet_vehicle_view_form"/>
        <arch type="xml">
            <div class="oe_button_box" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(fleet_vehicle_workshop_order_action)d"
                        icon="fa-wrench">
                    <field name="workshop_order_count" widget="statinfo" string="Reparaciones"/>
                </button>
            </div>
        </arch>
    </record>

    <record id="fleet_vehicle_set_workshop_order_count" model="ir.ui.view">
        <name>fleet.vehicle.form.inherit.workshop.count</name>
        <model>fleet.vehicle</model>
        <inherit_id ref="fleet.fleet_vehicle_view_form"/>
        <arch type="xml">
            <field name="log_count" position="after">
                <field name="workshop_order_count" invisible="1" compute="_compute_workshop_order_count"/>
            </field>
        </arch>
    </record>
</odoo>
