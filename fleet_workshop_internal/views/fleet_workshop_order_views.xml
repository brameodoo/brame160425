<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_workshop_order_action" model="ir.actions.act_window">
        <name>Órdenes de Trabajo</name>
        <type>ir.actions.act_window</type>
        <res_model>fleet.workshop.order</res_model>
        <view_mode>tree,form</view_mode>
        <domain></domain>
        <context></context>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva orden de trabajo
            </p><p>
                Registre aquí las órdenes de trabajo para el mantenimiento y reparación de la flota vehicular.
            </p>
        </help>
    </record>

    <record id="fleet_workshop_order_view_tree" model="ir.ui.view">
        <name>fleet.workshop.order.tree</name>
        <model>fleet.workshop.order</model>
        <arch type="tree">
            <field name="name"/>
            <field name="vehicle_id"/>
            <field name="request_date"/>
            <field name="reception_date"/>
            <field name="mechanic_id"/>
            <field name="state"/>
        </arch>
    </record>

    <record id="fleet_workshop_order_view_form" model="ir.ui.view">
        <name>fleet.workshop.order.form</name>
        <model>fleet.workshop.order</model>
        <arch type="form">
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" class="oe_inline"/></h1>
                </div>
                <group name="vehicle_info">
                    <group>
                        <field name="vehicle_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        <field name="license_plate" readonly="1"/>
                        <field name="vin_sn" readonly="1"/>
                        <field name="model_id" readonly="1"/>
                        <field name="driver_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        <field name="district_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="analyst_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        <field name="analyst_phone" readonly="1"/>
                        <field name="analyst_email" readonly="1"/>
                        <field name="contact_phone" readonly="1"/>
                    </group>
                </group>
                <group name="date_info">
                    <field name="request_date" readonly="1"/>
                    <field name="assignment_date" readonly="1"/>
                    <field name="reception_date"/>
                </group>
                <notebook>
                    <page string="Datos de Ingreso">
                        <group>
                            <field name="failure_description" readonly="1" nolabel="1"/>
                        </group>
                        <group>
                            <field name="mechanic_id" options="{'no_open': True, 'no_create': True}"/>
                            <button name="action_start_repair" type="object" string="Confirmar En Reparación" class="oe_highlight"
                                    attrs="{'invisible': [('state', '!=', 'assign_mechanic')]}"/>
                        </group>
                        <group>
                            <field name="odometer"/>
                            <field name="fuel_level"/>
                        </group>
                        <field name="diagnosis" placeholder="Diagnóstico del mecánico y procedimientos a realizar..."/>
                    </page>
                    <page string="Servicios">
                        <field name="service_ids" widget="many2many_tags"/>
                    </page>
                    <page string="Almacén">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="picking_count" widget="statinfo" string="Transferencias"/>
                        </button>
                        <field name="picking_ids" context="{'default_workshop_order_id': active_id}" readonly="1"/>
                        <group>
                            <button name="create_stock_picking" type="object" string="Crear Solicitud de Refacciones" class="oe_highlight"/>
                        </group>
                    </page>
                    <page string="Imágenes de Servicio">
                        <field name="repair_image_ids">
                            <tree>
                                <field name="description"/>
                                <field name="image" widget="image" options
                    <page string="Almacén">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="picking_count" widget="statinfo" string="Transferencias"/>
                        </button>
                        <field name="picking_ids" context="{'default_workshop_order_id': active_id}" readonly="1"/>
                        <group>
                            <button name="create_stock_picking" type="object" string="Crear Solicitud de Refacciones" class="oe_highlight"
                                    attrs="{'invisible': [('state', 'in', ('repaired'))]}"
                                    groups="stock.group_stock_user"/>
                        </group>
                    </page>                                    
