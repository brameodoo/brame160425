<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Acción para abrir la vista de solicitudes -->
    <record id="action_taller_solicitud" model="ir.actions.act_window">
        <field name="name">Solicitudes de Taller</field>
        <field name="res_model">taller.solicitud</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera solicitud de taller
            </p>
        </field>
    </record>

    <!-- Menú: debajo del menú raíz de Flota -->
    <menuitem id="menu_taller_solicitud"
              name="Solicitudes de Taller"
              parent="fleet.fleet_menu_root"
              action="action_taller_solicitud"
              sequence="20"/>
</odoo>
